<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:shorturls/Resources/Private/Language/locallang.xlf" date="2026-05-08T12:22:00Z" product-name="shorturls">
        <header/>
        <body>
            <trans-unit id="site_config.tab" resname="site_config.tab">
                <source>Short URLs</source>
                <target>Kurz-URLs</target>
            </trans-unit>
            <trans-unit id="site_config.button_doktypes" resname="site_config.button_doktypes">
                <source>Page types to show the Short URL button for</source>
                <target>Seitentypen, für die der Kurz-URL Button angezeigt wird</target>
            </trans-unit>
            <trans-unit id="site_config.button_on_siteroot" resname="site_config.button_on_siteroot">
                <source>Show the Short URL button on the site root page</source>
                <target>Kurz-URL-Button auch auf der Startseite anzeigen</target>
            </trans-unit>
            <trans-unit id="site_config.auto_generate" resname="site_config.auto_generate">
                <source>Automatically generate Short URL on page creation</source>
                <target>Kurz-URL automatisch beim Erstellen einer Seite generieren</target>
            </trans-unit>
            <trans-unit id="site_config.auto_generate_doktypes" resname="site_config.auto_generate_doktypes">
                <source>Page types to generate Short URLs for</source>
                <target>Seitentypen, für die Kurz-URLs generiert werden</target>
            </trans-unit>
            <trans-unit id="button.copy" resname="button.copy">
                <source>Copy Short URL</source>
                <target>Kurz-URL kopieren</target>
            </trans-unit>
            <trans-unit id="button.create" resname="button.create">
                <source>Create Short URL</source>
                <target>Kurz-URL erstellen</target>
            </trans-unit>
            <trans-unit id="confirm.create" resname="confirm.create">
                <source>Create Short URL for this page?</source>
                <target>Kurz-URL für diese Seite erstellen?</target>
            </trans-unit>
            <trans-unit id="controller.created" resname="controller.created">
                <source>Short URL %s has been created.</source>
                <target>Kurz-URL %s wurde erstellt.</target>
            </trans-unit>
            <trans-unit id="controller.error.generate" resname="controller.error.generate">
                <source>Short URL could not be generated.</source>
                <target>Kurz-URL konnte nicht generiert werden.</target>
            </trans-unit>
            <trans-unit id="controller.error.exists" resname="controller.error.exists">
                <source>A redirect already exists for this page.</source>
                <target>Es existiert bereits eine Umleitung für diese Seite.</target>
            </trans-unit>
            <trans-unit id="redirect_description" resname="redirect_description">
                <source>Automatically generated Short URL</source>
                <target>Automatisch erzeugte Kurz-URL</target>
            </trans-unit>
        </body>
    </file>
</xliff>
