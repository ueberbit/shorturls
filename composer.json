{
    "name": "ueberbit/shorturls",
    "description": "ShortUrl Button for Page View",
    "type": "typo3-cms-extension",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/ueberbit/shorturls",
    "authors": [
        {
            "name": "Jens Jacobsen"
        }
    ],
    "support": {
        "source": "https://github.com/ueberbit/shorturls",
        "issues": "https://github.com/ueberbit/shorturls/issues"
    },
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-redirects": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "typo3/tailor": "^1.7",
        "typo3/testing-framework": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "UEBERBIT\\Shorturls\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UEBERBIT\\Shorturls\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "tools:install": [
            "@composer install --working-dir=Build/rector --no-progress --quiet",
            "@composer install --working-dir=Build/php-cs-fixer --no-progress --quiet",
            "@composer install --working-dir=Build/phpstan --no-progress --quiet"
        ],
        "rector": [
            "@tools:install",
            "Build/rector/vendor/bin/rector --dry-run --config Build/rector/rector.php"
        ],
        "rector:fix": [
            "@tools:install",
            "Build/rector/vendor/bin/rector --config Build/rector/rector.php"
        ],
        "cgl": [
            "@tools:install",
            "Build/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff --config Build/php-cs-fixer/php-cs-fixer.php"
        ],
        "cgl:fix": [
            "@tools:install",
            "Build/php-cs-fixer/vendor/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-fixer.php"
        ],
        "phpstan": [
            "@tools:install",
            "Build/phpstan/vendor/bin/phpstan analyse -c Build/phpstan/phpstan.neon"
        ]
    },
    "scripts-descriptions": {
        "tools:install": "Install the dev tools in Build/rector, Build/php-cs-fixer and Build/phpstan",
        "rector": "Check code with Rector (dry-run)",
        "rector:fix": "Apply Rector changes",
        "cgl": "Check coding guidelines with php-cs-fixer (dry-run)",
        "cgl:fix": "Fix coding guidelines with php-cs-fixer",
        "phpstan": "Run static code analysis with PHPStan"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "shorturls",
            "web-dir": ".Build/public"
        },
        "typo3/cms-extension": {
            "importmap": {
                "@ueberbit/shorturls/": "Resources/Public/JavaScript/"
            }
        }
    }
}
